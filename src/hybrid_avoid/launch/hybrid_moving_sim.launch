<launch>
  <!-- One soft obstacle crosses the route once; rolling A-star must update online. -->
  <node pkg="hybrid_avoid" type="hybrid_obstacle_simulator.py" name="hybrid_obstacle_simulator" output="screen" clear_params="true">
    <param name="cmd_topic" value="/smoother_cmd_vel" />
    <param name="use_default_obstacle" value="false" />
    <param name="moving_obstacle" value="true" />
    <param name="moving_obstacle_x" value="4.5" />
    <param name="moving_obstacle_center_y" value="0.0" />
    <param name="moving_obstacle_amplitude" value="1.5" />
    <param name="moving_obstacle_period" value="8.0" />
    <param name="moving_obstacle_start_delay" value="5.0" />
    <param name="moving_obstacle_radius" value="0.28" />
    <rosparam param="obstacles">[]</rosparam>
  </node>
  <include file="$(find hybrid_avoid)/launch/hybrid_component.launch">
    <arg name="csv_path" value="$(find hybrid_avoid)/paths/active/hybrid_sim.csv" />
    <arg name="cmd_topic" value="/smoother_cmd_vel" />
    <arg name="target_speed" value="0.22" />
    <arg name="enabled" value="true" />
  </include>
</launch>
