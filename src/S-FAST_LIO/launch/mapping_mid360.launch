<launch>
<!-- Launch file for Livox MID360 LiDAR -->

	<arg name="rviz" default="true" />
	<arg name="enable_waypoint_record" default="false" />
	<arg name="waypoint_odom_topic" default="/Odometry" />
	<arg name="waypoint_task_topic" default="/waypoint_task" />
	<arg name="waypoint_stop_seconds_topic" default="/waypoint_stop_seconds" />
	<arg name="waypoint_file_name" default="" />
	<arg name="waypoint_output_dir" default="$(find waypoint_tools)/data" />
	<arg name="waypoint_min_distance" default="0.30" />
	<arg name="waypoint_min_yaw_change" default="0.35" />
	<arg name="waypoint_default_tol" default="0.30" />
		<arg name="waypoint_default_stop_seconds" default="10.0" />

	<rosparam command="load" file="$(find sfast_lio)/config/mid360.yaml" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="2"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.5" />
	<param name="filter_size_map" type="double" value="0.5" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="sfast_lio" type="sfastlio_mapping" name="laserMapping" output="screen" /> 
	<node pkg="waypoint_tools" type="record_waypoints.py" name="record_waypoints" output="screen" if="$(arg enable_waypoint_record)">
		<param name="odom_topic" value="$(arg waypoint_odom_topic)" />
		<param name="task_topic" value="$(arg waypoint_task_topic)" />
		<param name="stop_seconds_topic" value="$(arg waypoint_stop_seconds_topic)" />
		<param name="min_distance" value="$(arg waypoint_min_distance)" />
		<param name="min_yaw_change" value="$(arg waypoint_min_yaw_change)" />
		<param name="default_tol" value="$(arg waypoint_default_tol)" />
		<param name="default_stop_seconds" value="$(arg waypoint_default_stop_seconds)" />
		<param name="file_name" value="$(arg waypoint_file_name)" />
		<param name="output_dir" value="$(arg waypoint_output_dir)" />
	</node>

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find sfast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

</launch>
